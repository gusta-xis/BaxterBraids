{
  "name": "baxter-braids-provador",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/provador"]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "ratelimits": [
    {
      "name": "TRY_ON_RATE_LIMIT",
      "namespace_id": "77440963",
      "simple": { "limit": 3, "period": 60 }
    }
  ]
}
